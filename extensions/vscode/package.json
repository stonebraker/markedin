{
  "name": "markedin",
  "displayName": "Markedin Parser",
  "description": "Live preview and syntax highlighting for .mi files (YAML data + templated Markdown)",
  "icon": "icon.png",
  "version": "0.4.1",
  "publisher": "stonebraker",
  "repository": {
    "type": "git",
    "url": "https://github.com/stonebraker/markedin.git",
    "directory": "extensions/vscode"
  },
  "homepage": "https://github.com/stonebraker/markedin",
  "bugs": {
    "url": "https://github.com/stonebraker/markedin/issues"
  },
  "engines": { "vscode": "^1.74.0" },
  "categories": ["Languages", "Visualization"],
  "activationEvents": ["onLanguage:mi"],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "mi",
        "aliases": ["markedin", "mi"],
        "extensions": [".mi"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mi",
        "scopeName": "source.mi",
        "path": "./syntaxes/mi.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.yaml": "yaml",
          "meta.embedded.block.markdown": "markdown"
        }
      }
    ],
    "commands": [
      {
        "command": "markedin.preview",
        "title": "markedin: Open Preview",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markedin.preview",
          "when": "resourceExtname == .mi",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markedin.preview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "resourceExtname == .mi && editorTextFocus"
      }
    ]
  },
  "scripts": {
    "sync-parser": "cp ../../parsers/js/parse.js ./parse.js",
    "prepackage": "npm run sync-parser"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "marked": "^9.0.0"
  }
}
