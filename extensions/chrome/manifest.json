{
  "manifest_version": 3,
  "name": "Markedin",
  "description": "Render .mi (Markedin) files in the browser",
  "version": "0.4.0",
  "homepage_url": "https://github.com/stonebraker/markedin",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "include_globs": ["*.mi", "*.mi?*"],
      "js": ["lib/markedin.browser.min.js", "content.js"],
      "css": ["preview.css"],
      "run_at": "document_idle"
    }
  ]
}
